<?xml version="1.0" encoding="UTF-8"?>
<!--
  Framer - Auto vertical reframe for Adobe Premiere Pro
  CEP extension manifest. CSXS 9 covers CEP 9 through CEP 12,
  i.e. Premiere Pro CC 2019 (13.0) and later.
-->
<ExtensionManifest Version="9.0"
                   ExtensionBundleId="com.niterix.framer"
                   ExtensionBundleVersion="1.1.0"
                   ExtensionBundleName="Framer"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <ExtensionList>
    <Extension Id="com.niterix.framer.panel" Version="1.1.0"/>
  </ExtensionList>

  <ExecutionEnvironment>
    <HostList>
      <Host Name="PPRO" Version="[13.0,99.9]"/>
    </HostList>
    <LocaleList>
      <Locale Code="All"/>
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="9.0"/>
    </RequiredRuntimeList>
  </ExecutionEnvironment>

  <DispatchInfoList>
    <Extension Id="com.niterix.framer.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <ScriptPath>./jsx/framer.jsx</ScriptPath>
          <CEFCommandLine>
            <!-- Reference stills and source media are read from disk. -->
            <Parameter>--allow-file-access</Parameter>
            <Parameter>--allow-file-access-from-files</Parameter>
            <Parameter>--disable-web-security</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>Framer (Vertical Reframe)</Menu>
          <Geometry>
            <Size>
              <Height>820</Height>
              <Width>400</Width>
            </Size>
            <MinSize>
              <Height>540</Height>
              <Width>330</Width>
            </MinSize>
            <MaxSize>
              <Height>2400</Height>
              <Width>900</Width>
            </MaxSize>
          </Geometry>
          <Icons>
            <Icon Type="Normal">./icons/icon-normal.png</Icon>
            <Icon Type="RollOver">./icons/icon-rollover.png</Icon>
            <Icon Type="DarkNormal">./icons/icon-normal.png</Icon>
            <Icon Type="DarkRollOver">./icons/icon-rollover.png</Icon>
          </Icons>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
